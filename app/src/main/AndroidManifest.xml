<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Es una app de TV, pero no la atamos a leanback para poder probarla en un emulador común. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Solo para el servidor que recibe fondos desde el celular, dentro de la red de casa. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Para "el fondo que baila": Android exige el permiso de micrófono para ANALIZAR el audio que suena
        (Visualizer), aunque no se use el micrófono. Se pide recién cuando activás la opción.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
        Para elegir el protector de pantalla (Google TV no tiene pantalla para eso). No se puede pedir en pantalla:
        se concede UNA vez por ADB con scripts/debloat.ps1. Sin él, todo lo demás funciona igual.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Visibilidad de paquetes (Android 11+): sin esto, queryIntentActivities devuelve una lista VACÍA.
        Pedimos ver solo las apps de TV, no QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Las pantallas del panel de ajustes rápidos (QuickActions): sin esto, no sabríamos si existen. -->
        <intent><action android:name="com.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.oem.TIMER_SETTINGS" /></intent>
        <intent><action android:name="com.google.android.pano.action.SLEEP" /></intent>
        <intent><action android:name="com.google.android.intent.action.CONNECT_INPUT" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>

    <application
        android:name=".ConsolaApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ConsolaLauncher">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">

            <!-- Esto es lo que convierte una app común en un LAUNCHER: el sistema la ofrece para el botón Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Y esto la muestra en la lista de apps de la tele, para poder probarla ANTES de reemplazar el home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Para el widget "Reproduciendo ahora": Android solo deja ver qué está sonando a las apps con
            acceso a notificaciones. No leemos ninguna notificación.
        -->
        <service
            android:name=".widgets.MediaListener"
            android:exported="true"
            android:label="@string/media_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- El botón Ajustes del control: sin el inicio de Google, nadie lo atendía. Ver SettingsKeyService. -->
        <service
            android:name=".keys.SettingsKeyService"
            android:exported="true"
            android:label="@string/settings_key_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/settings_key_service" />
        </service>

        <!-- El protector de pantalla: tu fondo con la hora. -->
        <service
            android:name=".dream.BackgroundDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>

</manifest>
