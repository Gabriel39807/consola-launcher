<?xml version="1.0" encoding="utf-8"?>
<!--
    El tipo de superficie SOLO se puede elegir desde XML: PlayerView no tiene setter para esto.

    texture_view y no surface_view: en esta tele, una SurfaceView debajo de la interfaz no entra en
    los planos de hardware y el sistema la compone con la GPU (Comp Type: CLIENT en dumpsys SurfaceFlinger),
    escalada a la salida 4K en cada frame. Con TextureView el video es una textura más dentro de la app.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false" />
